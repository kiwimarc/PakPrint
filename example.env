# --- Dinero: personlig integration ---
# Client ID + Secret: Dinero > Indstillinger > Integrationer > "Se og opret API-nøgler" > Personlig integration
DINERO_CLIENT_ID=din_client_id_her
DINERO_CLIENT_SECRET=din_client_secret_her
# API-nøgle: oprettes samme sted, inde i den virksomhed du vil hente fakturaer fra
DINERO_API_KEY=din_personlige_api_noegle_her
# Firma-ID: står nederst til venstre når du er logget ind i Dinero
DINERO_ORG_ID=dit_organisations_id_her

# --- Afsender på følgesedlen (komma = ny linje) ---
SENDER_NAME=Produktionsvirksomhed ApS
SENDER_ADDRESS=Produktionsvej 1, 4000 Roskilde
SENDER_CVR=12345678

# --- Sikkerhed ---
# Adgangskode til appen. SKAL sættes, hvis appen kan nås fra internettet.
APP_PASSWORD=vaelg_en_lang_adgangskode
# Tilfældig nøgle der holder dig logget ind. Lav en med:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=indsaet_tilfaeldig_noegle_her

# --- Valgfrit ---
# Hvor mange dage tilbage fakturalisten viser
DAYS_BACK=60
# Netværk: 0.0.0.0 = synlig på dit Wi-Fi. 127.0.0.1 = kun via Tailscale Serve (se README)
HOST=0.0.0.0
PORT=5000
